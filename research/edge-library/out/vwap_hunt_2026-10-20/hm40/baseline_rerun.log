        y = [("03:00:00", 14000.0, 9000), ("09:30:00", 14990.0, 30), ("11:00:00", 15000.0, 40), ("15:00:00", 15010.0, 30),
             ("16:10:00", 16000.0, 9000)]
        asked = []
    
        def fake(d, root="NQ", **kw):
