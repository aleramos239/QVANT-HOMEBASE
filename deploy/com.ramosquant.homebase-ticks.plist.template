<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ramosquant.homebase-ticks</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>homebase.ticks</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- the tick archive's repair pass (homebase/ticks.py): it fetches only what the
       archive and the charts' live recording lack, so a run with nothing to do is
       silent and cheap. Every hour, and at load (login / boot, e.g. after a dead
       battery -- launchd runs no missed calendar job after a power-off); an hour
       slept through fires once on wake. 17:20 / 05:30 keep the close and the
       catch-up on time. By day at most 45 pages a run, never 09:20-09:35 ET, and
       a rate-limit reply ends the run; at night until done or 08:00 ET. The live
       login only (never the Apex login the 9:30 bot rides). One run at a time. -->
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>17</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__REPO__/homebase/.state/ticks.log</string>
  <key>StandardErrorPath</key><string>__REPO__/homebase/.state/ticks.log</string>
</dict>
</plist>
