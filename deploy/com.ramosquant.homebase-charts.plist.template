<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ramosquant.homebase-charts</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>homebase.charts</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- the chart half of the terminal: its OWN process so chart work can never
       delay an order or take the trading app down. Records live ticks. -->
  <!-- market data from the demo login only (real time, the same ticks: checked 2026-10-19). Tradovate serves the live
       login's market data to ONE connection, and the server's charts hold it; its Level 2 book comes here through
       the relay (homebase/charts/depthrelay.py, deploy/linux/depthrelay.sh) into /ws/depth-in. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOMEBASE_CHARTS_MD</key><string>demo</string>
    <key>HOMEBASE_CHARTS_MD_ONLY</key><string>demo</string>
    <key>HOMEBASE_DEPTH_RELAY_IN</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <!-- nice 5: at the 09:30 burst the trading app wins the CPU over chart work -->
  <key>Nice</key><integer>5</integer>
  <!-- 2026-10-02: the service ran out of file descriptors (EMFILE) at launchd's default of 256 while the machine was loaded -->
  <key>SoftResourceLimits</key>
  <dict><key>NumberOfFiles</key><integer>4096</integer></dict>
  <key>StandardOutPath</key><string>__REPO__/homebase/.state/charts.log</string>
  <key>StandardErrorPath</key><string>__REPO__/homebase/.state/charts.log</string>
</dict>
</plist>
