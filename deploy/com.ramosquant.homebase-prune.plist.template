<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ramosquant.homebase-prune</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>homebase.backtest.prune</string>
    <string>--days</string>
    <string>7</string>
    <string>--yes</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- the tester's old output (homebase/backtest/prune.py): runs, heat maps and walk-forwards older
       than 7 days that nothing references and nothing is running. About 1 GB a week grows there
       otherwise. Sundays 06:00 local; a Sunday slept through fires once on wake. -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__REPO__/homebase/.state/prune.log</string>
  <key>StandardErrorPath</key><string>__REPO__/homebase/.state/prune.log</string>
</dict>
</plist>
