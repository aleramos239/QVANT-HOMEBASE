<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ramosquant.homebase-vpssync</string>
  <key>ProgramArguments</key>
  <array><string>__REPO__/deploy/linux/vpssync.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- this Mac only: every commit on main goes to the server (the VPS Desk) by itself, when it is safe
       (deploy/linux/vpssync.sh: committed main only, it must import, flat accounts, not 09:10-09:35 ET,
       only the services the change reaches restart). Log: homebase/.state/vpssync.log -->
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__REPO__/homebase/.state/vpssync.out</string>
  <key>StandardErrorPath</key><string>__REPO__/homebase/.state/vpssync.out</string>
</dict>
</plist>
