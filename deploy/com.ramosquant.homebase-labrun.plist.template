<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ramosquant.homebase-labrun</string>
  <key>ProgramArguments</key>
  <array>
    <string>__REPO__/.venv/bin/python</string>
    <string>-m</string>
    <string>homebase.labrun</string>
    <string>--desk</string>
    <string>http://127.0.0.1:8850</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <!-- the runner of promoted Lab strategies (homebase/labrun/host.py): it reads the chart service's tick
       stream on 127.0.0.1:8852 and writes ~/.homebase/desklab. A strategy with NO account on the Desk runs
       in shadow: its orders are written down and nothing is sent. A strategy with accounts booked on the
       Desk (limits set, hosted before its window begins) has its orders sent to the Desk's own guarded
       intake on 127.0.0.1:8850 (/api/lab/*, with the key in homebase/.state/lab.key): the runner itself
       never talks to a broker. While the Desk's Lab side is off (no homebase/.state/lab_desk.on) or the
       key file does not read, those routes refuse it: a strategy with no account still runs in shadow, but
       one whose Desk sidecar still books accounts is hosted as a desk day that refuses every entry ("The
       Desk is not answering."): not shadow, and nothing reaches a broker. Its OWN process: a strategy's
       code runs in a sandboxed child of this job, never in the chart service or the trading app. With the chart service
       or the Desk down it waits and reconnects by itself. Reload this job outside the sessions only: a
       clean stop ends each desk day that has begun. -->
  <key>RunAtLoad</key><true/>
  <!-- kept alive, and never started again sooner than 30 s after it ended: a runner that keeps failing must not spin -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <!-- nice 10: below the chart service (5): at the 09:30 burst the trading app, then the charts, win the CPU -->
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__REPO__/homebase/.state/labrun.log</string>
  <key>StandardErrorPath</key><string>__REPO__/homebase/.state/labrun.log</string>
</dict>
</plist>
