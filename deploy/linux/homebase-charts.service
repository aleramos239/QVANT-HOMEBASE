[Unit]
Description=Homebase charts (:8852)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__REPO__
# the demo login only: Tradovate serves the live login's market data to ONE connection at a time, and the
# Mac's charts hold it (2026-10-19: both on live kicked each other off every ~5 min -- holes on both)
Environment=HOMEBASE_CHARTS_MD=demo
Environment=HOMEBASE_CHARTS_MD_ONLY=demo
ExecStart=__REPO__/.venv/bin/python -m homebase.charts
Restart=always
RestartSec=10
Nice=5
LimitNOFILE=4096
StandardOutput=append:__REPO__/homebase/.state/charts.log
StandardError=append:__REPO__/homebase/.state/charts.log

[Install]
WantedBy=multi-user.target
