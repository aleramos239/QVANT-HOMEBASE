[Unit]
Description=Homebase charts (:8852)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__REPO__
# the live login (Level 2): Tradovate serves its market data to ONE connection at a time, and this always-on
# server holds it (2026-10-19). The Mac's charts run demo-only and take this book through the relay
# (homebase/charts/depthrelay.py). YM / GC / SI ride the demo login (.state/charts/settings.json md_other_roots).
Environment=HOMEBASE_CHARTS_MD=live
ExecStart=__REPO__/.venv/bin/python -m homebase.charts
Restart=always
RestartSec=10
Nice=5
LimitNOFILE=4096
StandardOutput=append:__REPO__/homebase/.state/charts.log
StandardError=append:__REPO__/homebase/.state/charts.log

[Install]
WantedBy=multi-user.target
