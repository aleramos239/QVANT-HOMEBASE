//@version=6
// NQ 09:30 open-volatility straddle — OCO stop entries (2026-09-16, r7)
//
// r7 = SPEC AMENDMENT 2026-09-16: the TREND regime gate default is now OFF
//   (trade every weekday). User decision on the aligned-year comparison
//   (OFF n=230 $62.8k t 6.81 PF 2.63 vs ON n=139 $34.2k t 4.76 PF 2.40,
//   same maxDD). NOTE: the sealed-year exam validated the GATED variant;
//   the toggle remains for comparison exports. Everything else = r6/r5.
//
// r6 = r5 + Homebase webhook: paste the app's secret into the "Webhook
//   secret" input, create ONE TV alert on this strategy with condition
//   "Any alert() function call" (open-ended) and the app's /hook URL.
//   Fires once at 9:30:00 with the exact trigger prices.
//   Strategy logic is byte-identical to r5 (the validated champion).
//
// r5 = the APPROVED champion as defaults (spec 2026-09-09):
//   entry offset ±10 pts off the 9:29 close · SL 5 · TP 15 (both from fill)
//   TREND-days-only gate ON (yesterday's daily ADX14 > threshold, default 20)
//   3 minis (approved main size; set 2 in Properties for the conservative alt)
// NOTE: all research tables were built at 1 mini — divide P&L by 3 to compare.
// The gate toggle lets you run unfiltered for comparison exports.
//
// Regime tags (in each entry's comment -> CSV Signal column) are now 3-way,
// matching the analysis and the Regime Detector indicator:
//   "V:N U:H TREND" -> Volatility NORMAL, Volume HIGH, Trending day
//   V/U: yesterday's daily ATR14 (vs 50d avg) / volume (vs 20d avg);
//   L < 0.85, N 0.85-1.15, H > 1.15. TREND/CHOP: daily ADX14 vs threshold.
// All regimes use COMPLETED daily bars — no lookahead, no repaint, identical
// on any chart timeframe. CHOP days are tagged even when gated (no trade).
//
// Mechanics otherwise unchanged: OCO (first fill cancels the other), one
// trade/day, unfilled entries cancel 12:55 ET, flat 15:55 ET, $2/side + 1
// tick slippage. Run on NQ1! ETH chart, 15-second timeframe preferred.
// Leave Properties recalc options OFF.
strategy("NQ 9:30 Straddle", overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.fixed, default_qty_value = 3,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 2.0,
     slippage = 1, pyramiding = 0,
     margin_long = 0, margin_short = 0,
     calc_on_order_fills = false, process_orders_on_close = false)

offPts = input.float(10.0, "Entry offset (points from 9:29 close)", minval = 1, step = 5)
slPts  = input.float(5.0,  "Stop loss (points from entry)",         minval = 1, step = 5)
tpPts  = input.float(15.0, "Take profit (points from entry)",       minval = 1, step = 5)
gateT  = input.bool(false, "Trade TREND days only (removed from spec 2026-09-16)")
adxTh  = input.float(20.0, "ADX trend threshold (daily)",           minval = 5, step = 1)
bandLo = input.float(0.85, "Regime LOW band (ratio below)",         minval = 0.1, step = 0.05)
bandHi = input.float(1.15, "Regime HIGH band (ratio above)",        minval = 1.0, step = 0.05)
hookSec = input.string("", "Webhook secret (Homebase)", tooltip = "Paste from the app's TradingView setup card. Empty = no alert payload.")

// ---- regime detection (yesterday's completed daily values, non-repainting) ----
f_adx() =>
    [dip, dim, adxv] = ta.dmi(14, 14)
    adxv[1]
dAtr    = request.security(syminfo.tickerid, "D", ta.atr(14)[1],             lookahead = barmerge.lookahead_on)
dAtrAvg = request.security(syminfo.tickerid, "D", ta.sma(ta.atr(14), 50)[1], lookahead = barmerge.lookahead_on)
dVol    = request.security(syminfo.tickerid, "D", volume[1],                 lookahead = barmerge.lookahead_on)
dVolAvg = request.security(syminfo.tickerid, "D", ta.sma(volume, 20)[1],     lookahead = barmerge.lookahead_on)
dAdx    = request.security(syminfo.tickerid, "D", f_adx(),                   lookahead = barmerge.lookahead_on)

band(r) => na(r) ? "?" : r < bandLo ? "L" : r > bandHi ? "H" : "N"
volTag = band(dAtr / dAtrAvg)
vlmTag = band(dVol / dVolAvg)
tSt = na(dAdx) ? -1 : dAdx > adxTh ? 1 : 0        // 1 TREND, 0 CHOP, -1 warm-up
trdTag = tSt == -1 ? "?" : tSt == 1 ? "TREND" : "CHOP"
rgm = "V:" + volTag + " U:" + vlmTag + " " + trdTag

NY = "America/New_York"
t930  = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), 9, 30, 0)
t1255 = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), 12, 55, 0)
t1555 = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), 15, 55, 0)

var bool  placed   = false
var float buyTrig  = na
var float sellTrig = na
if ta.change(dayofmonth(time, NY)) != 0
    placed   := false
    buyTrig  := na
    sellTrig := na

// the bar that closes exactly at (or first crosses) 09:30:00 ET
armBar = time < t930 and time_close >= t930
// approved gate: only TREND days trade (warm-up days do NOT trade when gated)
gateOK = not gateT or tSt == 1

if armBar and not placed and strategy.position_size == 0 and gateOK
    buyTrig  := close + offPts
    sellTrig := close - offPts
    strategy.entry("L", strategy.long,  stop = buyTrig,
         oca_name = "straddle", oca_type = strategy.oca.cancel, comment = rgm)
    strategy.entry("S", strategy.short, stop = sellTrig,
         oca_name = "straddle", oca_type = strategy.oca.cancel, comment = rgm)
    // provisional brackets, trigger-anchored — cover the fill bar itself
    strategy.exit("XL", from_entry = "L",
         stop  = buyTrig - slPts,  limit = buyTrig + tpPts)
    strategy.exit("XS", from_entry = "S",
         stop  = sellTrig + slPts, limit = sellTrig - tpPts)
    placed := true
    // Homebase webhook — the app validates the spread against its own frozen
    // config and places the bracketed straddle at the broker
    if hookSec != ""
        alert('{"secret":"' + hookSec + '","strategy":"nq930","upper":'
             + str.tostring(buyTrig, format.mintick) + ',"lower":'
             + str.tostring(sellTrig, format.mintick) + '}',
             alert.freq_once_per_bar)

// once filled, re-anchor the bracket to the ACTUAL entry fill price:
// stop exactly slPts away, TP exactly tpPts away
avg = strategy.position_avg_price
if strategy.position_size > 0
    strategy.exit("XL", from_entry = "L",
         stop = avg - slPts, limit = avg + tpPts)
if strategy.position_size < 0
    strategy.exit("XS", from_entry = "S",
         stop = avg + slPts, limit = avg - tpPts)

// 12:55 ET — entries that never filled are dead for the day (also prevents a
// pending stop from surviving a holiday 13:00 halt into the 18:00 reopen)
if time_close >= t1255 and placed and strategy.position_size == 0 and not na(buyTrig)
    strategy.cancel_all()
    buyTrig  := na
    sellTrig := na

// 15:55 ET — cancel anything pending, flatten anything open
if time_close >= t1555 and (placed or strategy.position_size != 0)
    strategy.cancel_all()
    buyTrig  := na
    sellTrig := na
    if strategy.position_size != 0
        strategy.close_all(comment = "EOD")

// ---- chart feedback ----
flatPend = strategy.position_size == 0 and placed
slPx = strategy.position_size > 0 ? avg - slPts :
       strategy.position_size < 0 ? avg + slPts : na
tpPx = strategy.position_size > 0 ? avg + tpPts :
       strategy.position_size < 0 ? avg - tpPts : na
plot(flatPend ? buyTrig  : na, "Buy trigger",  color.aqua,   1, plot.style_cross)
plot(flatPend ? sellTrig : na, "Sell trigger", color.orange, 1, plot.style_cross)
plot(slPx, "SL", color.red,   2, plot.style_linebr)
plot(tpPx, "TP", color.green, 2, plot.style_linebr)
bgcolor(gateT and tSt == 0 ? color.new(color.gray, 88) : na, title = "CHOP (no trade) shade")

nm(s) => s == "L" ? "LOW" : s == "N" ? "NORMAL" : s == "H" ? "HIGH" : "?"
var table rt = table.new(position.top_right, 1, 4)
if barstate.islast
    table.cell(rt, 0, 0, "Volatility: " + nm(volTag),
         text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.small)
    table.cell(rt, 0, 1, "Volume: " + nm(vlmTag),
         text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.small)
    table.cell(rt, 0, 2, "Daily: " + trdTag,
         text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.small)
    table.cell(rt, 0, 3, not gateT ? "gate OFF" : tSt == 1 ? "TRADE DAY" : "NO TRADE",
         text_color = color.white,
         bgcolor = not gateT ? color.new(color.gray, 40) :
                   tSt == 1 ? color.new(color.teal, 20) : color.new(color.red, 30),
         text_size = size.small)
