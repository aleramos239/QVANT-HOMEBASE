//@version=6
// YM 9:30 straddle — OCO stop entries (2026-09-13, y1). Pre-registered
// candidate from the 2021-24 local screen (research/ym_930_straddle_wide.py):
// offset 20 / SL 10 / TP 15 (1:1.5), UNFILTERED — base/flip t 4.79/3.35 vs
// floor 2.11, 4/4 years green, WR 53.7%, 13.8% entry-bar ambiguity.
// Run on CBOT_MINI:YM1! (ETH chart), 15-SECOND timeframe.
//
// Notes for YM:
//   · Defaults = the pre-registered config. Alternate to test: TP 20 (1:2,
//     less certain — its flip bound sat under the floor).
//   · All regime filter switches default OFF — the YM edge showed in every
//     regime; tags still record for the pivot tables.
//   · YM tick = 1pt ($5): friction is ~28% of risk at SL 10, and the YM book
//     is thinner than NQ/ES — fill quality is the live risk.
//   · g2: cancel/flat deadlines are RELATIVE to the event (defaults keep the
//     NQ timing for a 9:30 event: cancel unfilled +205min = 12:55, flat
//     +385min = 15:55) — so evening events like 20:00 work, incl. past
//     midnight.
//   · g3/g4: independent DAY FILTERS, each with its own master switch.
//     "Use ... filter" turns that filter on; the LOW/NORMAL/HIGH (or
//     TREND/CHOP) checkboxes then say which days are allowed. All switches
//     off (default) = unfiltered. Active filters AND together; warm-up
//     ("?") days do not trade under an active filter. Tags always record.
//
// Regime tags (in each entry's comment -> CSV Signal column) are now 3-way,
// matching the analysis and the Regime Detector indicator:
//   "V:N U:H TREND" -> Volatility NORMAL, Volume HIGH, Trending day
//   V/U: yesterday's daily ATR14 (vs 50d avg) / volume (vs 20d avg);
//   L < 0.85, N 0.85-1.15, H > 1.15. TREND/CHOP: daily ADX14 vs threshold.
// All regimes use COMPLETED daily bars — no lookahead, no repaint, identical
// on any chart timeframe. CHOP days are tagged even when gated (no trade).
//
// Mechanics otherwise unchanged: OCO (first fill cancels the other), one
// trade/day, unfilled entries cancel 12:55 ET, flat 15:55 ET, $2/side + 1
// tick slippage. Run on NQ1! ETH chart, 15-second timeframe preferred.
// Leave Properties recalc options OFF.
strategy("YM 9:30 Straddle", overlay = true,
     initial_capital = 100000,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     commission_type = strategy.commission.cash_per_contract,
     commission_value = 2.0,
     slippage = 1, pyramiding = 0,
     margin_long = 0, margin_short = 0,
     calc_on_order_fills = false, process_orders_on_close = false)

evH    = input.int(9,     "Event hour (ET)",   minval = 0, maxval = 23)
evM    = input.int(30,    "Event minute (ET)", minval = 0, maxval = 59)
offPts = input.float(20.0, "Entry offset (points from pre-event close)", minval = 1, step = 5)
slPts  = input.float(10.0, "Stop loss (points from entry)",             minval = 1, step = 5)
tpPts  = input.float(15.0, "Take profit (points from entry)",           minval = 1, step = 5)
cxlMin = input.int(205, "Cancel unfilled entries after (minutes)", minval = 5)
flatMin= input.int(385, "Flatten / end trade after (minutes)",     minval = 10)
grpV = "Volatility filter"
vUse = input.bool(false, "Use volatility filter", group = grpV)
vL = input.bool(true, "LOW",    group = grpV, inline = "v")
vN = input.bool(true, "NORMAL", group = grpV, inline = "v")
vH = input.bool(true, "HIGH",   group = grpV, inline = "v")
grpU = "Volume filter"
uUse = input.bool(false, "Use volume filter", group = grpU)
uL = input.bool(true, "LOW",    group = grpU, inline = "u")
uN = input.bool(true, "NORMAL", group = grpU, inline = "u")
uH = input.bool(true, "HIGH",   group = grpU, inline = "u")
grpT = "Trend filter"
tUse = input.bool(false, "Use trend filter", group = grpT)
tT = input.bool(true, "TREND",  group = grpT, inline = "t")
tC = input.bool(true, "CHOP",   group = grpT, inline = "t")
adxTh  = input.float(20.0, "ADX trend threshold (daily)",           minval = 5, step = 1)
bandLo = input.float(0.85, "Regime LOW band (ratio below)",         minval = 0.1, step = 0.05)
bandHi = input.float(1.15, "Regime HIGH band (ratio above)",        minval = 1.0, step = 0.05)

// ---- regime detection (yesterday's completed daily values, non-repainting) ----
f_adx() =>
    [dip, dim, adxv] = ta.dmi(14, 14)
    adxv[1]
dAtr    = request.security(syminfo.tickerid, "D", ta.atr(14)[1],             lookahead = barmerge.lookahead_on)
dAtrAvg = request.security(syminfo.tickerid, "D", ta.sma(ta.atr(14), 50)[1], lookahead = barmerge.lookahead_on)
dVol    = request.security(syminfo.tickerid, "D", volume[1],                 lookahead = barmerge.lookahead_on)
dVolAvg = request.security(syminfo.tickerid, "D", ta.sma(volume, 20)[1],     lookahead = barmerge.lookahead_on)
dAdx    = request.security(syminfo.tickerid, "D", f_adx(),                   lookahead = barmerge.lookahead_on)

band(r) => na(r) ? "?" : r < bandLo ? "L" : r > bandHi ? "H" : "N"
volTag = band(dAtr / dAtrAvg)
vlmTag = band(dVol / dVolAvg)
tSt = na(dAdx) ? -1 : dAdx > adxTh ? 1 : 0        // 1 TREND, 0 CHOP, -1 warm-up
trdTag = tSt == -1 ? "?" : tSt == 1 ? "TREND" : "CHOP"
rgm = "V:" + volTag + " U:" + vlmTag + " " + trdTag

NY = "America/New_York"
t930  = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), evH, evM, 0)
var bool  placed   = false
var float buyTrig  = na
var float sellTrig = na
var float tCxl     = na
var float tFlat    = na
if ta.change(dayofmonth(time, NY)) != 0
    placed   := false
    buyTrig  := na
    sellTrig := na

// the bar that closes exactly at (or first crosses) the event time
armBar = time < t930 and time_close >= t930
// day filters: an ACTIVE filter requires the day's state to be checked;
// inactive filters are ignored; "?" (warm-up) fails any active filter
ok3(tag, aL, aN, aH) => tag == "L" ? aL : tag == "N" ? aN : tag == "H" ? aH : false
gateOK = (not vUse or ok3(volTag, vL, vN, vH)) and
         (not uUse or ok3(vlmTag, uL, uN, uH)) and
         (not tUse or (tSt == 1 ? tT : tSt == 0 ? tC : false))
filtersOn = vUse or uUse or tUse

if armBar and not placed and strategy.position_size == 0 and gateOK
    buyTrig  := close + offPts
    sellTrig := close - offPts
    strategy.entry("L", strategy.long,  stop = buyTrig,
         oca_name = "straddle", oca_type = strategy.oca.cancel, comment = rgm)
    strategy.entry("S", strategy.short, stop = sellTrig,
         oca_name = "straddle", oca_type = strategy.oca.cancel, comment = rgm)
    // provisional brackets, trigger-anchored — cover the fill bar itself
    strategy.exit("XL", from_entry = "L",
         stop  = buyTrig - slPts,  limit = buyTrig + tpPts)
    strategy.exit("XS", from_entry = "S",
         stop  = sellTrig + slPts, limit = sellTrig - tpPts)
    tCxl  := t930 + cxlMin * 60000
    tFlat := t930 + flatMin * 60000
    placed := true

// once filled, re-anchor the bracket to the ACTUAL entry fill price:
// stop exactly slPts away, TP exactly tpPts away
avg = strategy.position_avg_price
if strategy.position_size > 0
    strategy.exit("XL", from_entry = "L",
         stop = avg - slPts, limit = avg + tpPts)
if strategy.position_size < 0
    strategy.exit("XS", from_entry = "S",
         stop = avg + slPts, limit = avg - tpPts)

// cancel deadline — entries that never filled are dead (also prevents a
// pending stop from surviving a session halt into a reopen)
if not na(tCxl) and time_close >= tCxl and strategy.position_size == 0
    strategy.cancel_all()
    buyTrig  := na
    sellTrig := na
    tCxl := na

// flat deadline — cancel anything pending, flatten anything open
if not na(tFlat) and time_close >= tFlat
    strategy.cancel_all()
    buyTrig  := na
    sellTrig := na
    if strategy.position_size != 0
        strategy.close_all(comment = "EOD")
    tCxl  := na
    tFlat := na

// ---- chart feedback ----
flatPend = strategy.position_size == 0 and placed
slPx = strategy.position_size > 0 ? avg - slPts :
       strategy.position_size < 0 ? avg + slPts : na
tpPx = strategy.position_size > 0 ? avg + tpPts :
       strategy.position_size < 0 ? avg - tpPts : na
plot(flatPend ? buyTrig  : na, "Buy trigger",  color.aqua,   1, plot.style_cross)
plot(flatPend ? sellTrig : na, "Sell trigger", color.orange, 1, plot.style_cross)
plot(slPx, "SL", color.red,   2, plot.style_linebr)
plot(tpPx, "TP", color.green, 2, plot.style_linebr)
bgcolor(filtersOn and not gateOK ? color.new(color.gray, 88) : na, title = "filtered (no trade) shade")

nm(s) => s == "L" ? "LOW" : s == "N" ? "NORMAL" : s == "H" ? "HIGH" : "?"
var table rt = table.new(position.top_right, 1, 4)
if barstate.islast
    table.cell(rt, 0, 0, "Volatility: " + nm(volTag),
         text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.small)
    table.cell(rt, 0, 1, "Volume: " + nm(vlmTag),
         text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.small)
    table.cell(rt, 0, 2, "Daily: " + trdTag,
         text_color = color.white, bgcolor = color.new(color.black, 25), text_size = size.small)
    table.cell(rt, 0, 3, not filtersOn ? "filters OFF" : gateOK ? "TRADE DAY" : "NO TRADE",
         text_color = color.white,
         bgcolor = not filtersOn ? color.new(color.gray, 40) :
                   gateOK ? color.new(color.teal, 20) : color.new(color.red, 30),
         text_size = size.small)
