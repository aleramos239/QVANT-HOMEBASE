//@version=6
// HB parity P1 -- bar math in TradingView's own words, one value per Homebase study. Column name = tv|<homebase key>|<field>;
// tools/tvparity.py reads the "Export chart data" CSV (docs/tvparity-export-recipe.md). Our own code, no TradingView data.
// Layout A puts the real built-ins beside this script: if a built-in and its column here differ, the built-in is the truth.
indicator("HB parity P1", overlay=false, precision=10)
D = display.data_window                         // hidden on the chart, still exported (Pine FAQ)
plot(1, "tv|probe|P1", display=D)
plot(volume, "tv|vol|", display=D)
plot(ta.sma(close, 50), "tv|sma:50|", display=D)
plot(ta.ema(close, 20), "tv|ema:20|", display=D)
plot(ta.vwma(close, 20), "tv|vwma:20|", display=D)
e1 = ta.ema(close, 20)
e2 = ta.ema(e1, 20)
e3 = ta.ema(e2, 20)
plot(3 * (e1 - e2) + e3, "tv|tema:20|", display=D)
plot(ta.rsi(close, 14), "tv|rsi:14|", display=D)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)
plot(macdLine, "tv|macd:12:26:9|macd", display=D)
plot(signalLine, "tv|macd:12:26:9|signal", display=D)
plot(histLine, "tv|macd:12:26:9|hist", display=D)
[bbMid, bbUp, bbDn] = ta.bb(close, 20, 2)
plot(bbMid, "tv|bb:20:2|mid", display=D)
plot(bbUp, "tv|bb:20:2|up", display=D)
plot(bbDn, "tv|bb:20:2|dn", display=D)
plot(ta.atr(14), "tv|atr:14|", display=D)
stK = ta.sma(ta.stoch(close, high, low, 14), 3)
plot(stK, "tv|stoch:14:3:3|k", display=D)
plot(ta.sma(stK, 3), "tv|stoch:14:3:3|d", display=D)
[stLine, stDir] = ta.supertrend(3, 10)
plot(stLine, "tv|supertrend:10:3|line", display=D)
plot(stDir, "tv|supertrend:10:3|dir", display=D)    // Pine's sign, -1 up: what tv:supertrend returns (tvparity.py flips it for the house study)
dcUp = ta.highest(high, 20)
dcDn = ta.lowest(low, 20)
plot(dcUp, "tv|donchian:20|up", display=D)
plot(dcDn, "tv|donchian:20|dn", display=D)
plot((dcUp + dcDn) / 2, "tv|donchian:20|mid", display=D)
kMid = ta.ema(close, 20)
kW = 1.5 * ta.atr(20)                               // the built-in's "Average True Range" style: an RMA where Homebase takes an SMA
// the title is the house key (n, band length, mult); tvparity.py runs it as tv:keltner:20:1.5:20
plot(kMid, "tv|keltner:20:20:1.5|mid", display=D)
plot(kMid + kW, "tv|keltner:20:20:1.5|up", display=D)
plot(kMid - kW, "tv|keltner:20:20:1.5|dn", display=D)
plot(ta.mfi(hlc3, 14), "tv|mfi:14|", display=D)
[diPlus, diMinus, adxLine] = ta.dmi(14, 14)
plot(adxLine, "tv|adx:14|adx", display=D)
plot(diPlus, "tv|adx:14|pdi", display=D)
plot(diMinus, "tv|adx:14|mdi", display=D)
[vw, vwUp, vwDn] = ta.vwap(hlc3, timeframe.change("D"), 1)
plot(vw, "tv|vwap|vwap", display=D)
plot(vwUp - vw, "tv|vwap|sd", display=D)
plot(math.abs(close - close[14]) / math.sum(math.abs(ta.change(close)), 14), "tv|er:14|", display=D)
plot(request.security(syminfo.tickerid, "60", ta.ema(close, 20)), "tv|ema:20@3600|", display=D)
plot(request.security(syminfo.tickerid, "D", ta.sma(close, 50)), "tv|sma:50@86400|", display=D)
